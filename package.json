{
  "name": "zuka",
  "version": "1.1.0",
  "private": true,
  "description": "Zuka: aprende matemáticas y estadística en español, paso a paso",
  "scripts": {
    "dev": "node scripts/build.cjs && node server.cjs",
    "dev:movil": "node scripts/build.cjs && node server.cjs --red",
    "build": "npm run check && node scripts/build.cjs",
    "check": "node scripts/check.cjs",
    "test": "node scripts/build.cjs && node --test tests/*.test.cjs",
    "content": "node scripts/build.cjs"
  },
  "engines": {
    "node": ">=20"
  }
}
